AI_ENABLED=false

# Provider credentials
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local FreeLLMAPI gateway
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_SECONDS=120

# Provider models
OPENAI_MODEL=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

# Provider routing, left to right
BOUND_PROVIDER_ORDER=freellmapi,openai,gemini,groq,openrouter

# OpenRouter metadata
OPENROUTER_APP_NAME=BOUND Operator
OPENROUTER_SITE_URL=

# Fictional comparison prices in USD per 1M tokens.
# These are shadow-accounting values, NOT vendor billing prices.
BOUND_SHADOW_FREELLMAPI_INPUT_PER_M=0.00
BOUND_SHADOW_FREELLMAPI_OUTPUT_PER_M=0.00
BOUND_SHADOW_OPENAI_INPUT_PER_M=2.00
BOUND_SHADOW_OPENAI_OUTPUT_PER_M=8.00
BOUND_SHADOW_GEMINI_INPUT_PER_M=1.00
BOUND_SHADOW_GEMINI_OUTPUT_PER_M=4.00
BOUND_SHADOW_GROQ_INPUT_PER_M=0.50
BOUND_SHADOW_GROQ_OUTPUT_PER_M=2.00
BOUND_SHADOW_OPENROUTER_INPUT_PER_M=0.25
BOUND_SHADOW_OPENROUTER_OUTPUT_PER_M=1.00

DATABASE_URL=postgresql://bound:CHANGE_ME@localhost:5432/bound

BOUND_SECRET=
BOUND_HOST=0.0.0.0
BOUND_PORT=8765

# Skill / agent supply-chain gate
BOUND_SKILLSPECTOR_BIN=
BOUND_SKILLSPECTOR_TIMEOUT=240
BOUND_SKILLSPECTOR_SEMANTIC=false
BOUND_CAPABILITY_QUARANTINE_ROOT=/var/lib/bound/capabilities/quarantine
BOUND_CAPABILITY_ALLOW_REMOTE_URLS=false

# Optional: route SkillSpector semantic analysis through local FreeLLMAPI.
# Enable only after the static gate is working.
# SKILLSPECTOR_PROVIDER=openai_compatible
# SKILLSPECTOR_COMPAT_BASE_URL=http://127.0.0.1:3001/v1
# SKILLSPECTOR_COMPAT_API_KEY=
# SKILLSPECTOR_MODEL=auto

# Agent oversight
# always | concerns | off
BOUND_SENTINEL_MODE=always

# Outbound-only school edge connector
# Generate a long random value and store the same secret only on BOUND and the
# school connector. If Cloudflare Access protects the hostname, also create a
# Cloudflare service token for /edge/v1/* and configure it on the connector.
BOUND_SCHOOL_EDGE_TOKEN=
